# OpenAI-compatible LLM endpoints. Populate any you plan to use; missing
# vars cause the matching config endpoint to report hasKey: false.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Postgres connection. Defaults to a local instance.
DB_URL=postgresql://openshuki:openshuki@localhost:5432/openshuki

# Optional. Defaults to 4000.
PORT=

# LangGraph Platform OSS server. Used by the langgraph runner (Phase C+).
# `langgraph dev` defaults to 2024; the docker compose at the repo root maps
# the langgraph-api container's :8000 to host :2024.
LANGGRAPH_URL=http://localhost:2024
# Optional API key if you front the platform with auth. Closed-network deploys
# can leave this blank.
LANGGRAPH_API_KEY=
