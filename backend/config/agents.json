{
  "agents": [
    {
      "id": "weather",
      "name": "Weather forecast",
      "description": "Mock multi-day weather forecast for a city. 2-node LangGraph (Python).",
      "model": null,
      "inputs": [
        {
          "name": "location",
          "label": "City",
          "type": "string",
          "required": true,
          "description": "City or area to forecast (e.g. Tokyo)."
        },
        {
          "name": "days",
          "label": "Days",
          "type": "number",
          "default": 3,
          "description": "Number of days to forecast."
        }
      ],
      "exec": {
        "kind": "subprocess",
        "command": "{VENV_PYTHON}",
        "args": [
          "-u",
          "{AGENTS_DIR}/weather/main.py",
          "--location",
          "{location}",
          "--days",
          "{days}"
        ],
        "cwd": "{AGENTS_DIR}/weather",
        "protocol": "jsonl"
      }
    },
    {
      "id": "traffic",
      "name": "Traffic estimate",
      "description": "Mock traffic estimate between two locations. 2-node LangGraph (TypeScript).",
      "model": null,
      "inputs": [
        {
          "name": "origin",
          "label": "From",
          "type": "string",
          "required": true,
          "description": "Origin (e.g. Shibuya)."
        },
        {
          "name": "destination",
          "label": "To",
          "type": "string",
          "required": true,
          "description": "Destination (e.g. Shinjuku)."
        }
      ],
      "exec": {
        "kind": "subprocess",
        "command": "npx",
        "args": [
          "tsx",
          "{AGENTS_DIR}/traffic/main.ts",
          "--origin",
          "{origin}",
          "--destination",
          "{destination}"
        ],
        "cwd": "{AGENTS_DIR}/traffic",
        "protocol": "jsonl"
      }
    },
    {
      "id": "quick-note",
      "name": "Quick note",
      "description": "Capture a quick note from the user (prompt + tag) and save it as a markdown artifact.",
      "model": null,
      "inputs": [
        {
          "name": "prefix",
          "label": "Heading prefix",
          "type": "string",
          "default": "Note",
          "description": "Label used in the note's heading (e.g. 'Note', 'Reminder', 'Idea')."
        }
      ],
      "exec": {
        "kind": "subprocess",
        "command": "{VENV_PYTHON}",
        "args": [
          "-u",
          "{AGENTS_DIR}/quick-note/main.py",
          "--prefix",
          "{prefix}"
        ],
        "cwd": "{AGENTS_DIR}/quick-note",
        "protocol": "jsonl"
      }
    },
    {
      "id": "ask-demo",
      "name": "Ask demo",
      "description": "Minimal demo of the agent ↔ user Q&A channel: asks for your name and confirms how you'd like to be addressed.",
      "model": null,
      "inputs": [
        {
          "name": "greeting",
          "label": "Greeting",
          "type": "string",
          "default": "Hi",
          "description": "Opening word the agent uses (e.g. 'Hi', 'Hello', 'Greetings')."
        }
      ],
      "exec": {
        "kind": "subprocess",
        "command": "{VENV_PYTHON}",
        "args": [
          "-u",
          "{AGENTS_DIR}/ask-demo/main.py",
          "--greeting",
          "{greeting}"
        ],
        "cwd": "{AGENTS_DIR}/ask-demo",
        "protocol": "jsonl"
      }
    },
    {
      "id": "meeting-planner",
      "name": "Meeting planner",
      "description": "Find a slot and send an Outlook invite to a group, honouring urgency. Asks which clashing meetings can be overridden and learns your rules over time. Mock Outlook COM (Python).",
      "model": null,
      "inputs": [
        {
          "name": "people",
          "label": "People",
          "type": "string",
          "required": true,
          "description": "Comma-separated attendees (names or emails)."
        },
        {
          "name": "urgency",
          "label": "Urgency",
          "type": "string",
          "default": "7d",
          "description": "How soon: asap | 2d | 7d | 30d."
        },
        {
          "name": "subject",
          "label": "Subject",
          "type": "string",
          "default": "Meeting",
          "description": "Meeting title."
        },
        {
          "name": "duration_min",
          "label": "Duration (min)",
          "type": "number",
          "default": 30,
          "description": "Meeting length in minutes."
        }
      ],
      "onboarding": [
        {
          "name": "workdayStart",
          "label": "Workday start",
          "type": "string",
          "default": "09:00",
          "section": "Working hours",
          "description": "Earliest hour to schedule (HH:MM)."
        },
        {
          "name": "workdayEnd",
          "label": "Workday end",
          "type": "string",
          "default": "17:00",
          "section": "Working hours",
          "description": "Latest hour a meeting may end (HH:MM)."
        },
        {
          "name": "defaultDurationMin",
          "label": "Default duration (min)",
          "type": "number",
          "default": 30,
          "section": "Working hours",
          "description": "Used when you don't override the duration on a run."
        },
        {
          "name": "alwaysOverride",
          "label": "Always overridable",
          "type": "string_list",
          "section": "Override rules",
          "description": "Meeting subjects/categories that may always be bumped (e.g. 'Employee Holiday', 'Team Lunch'). The agent adds to this as you clear cases."
        },
        {
          "name": "neverOverride",
          "label": "Never override",
          "type": "string_list",
          "section": "Override rules",
          "description": "Meeting subjects/categories that must never be bumped (e.g. 'Customer Demo', 'Interview')."
        }
      ],
      "exec": {
        "kind": "subprocess",
        "command": "{VENV_PYTHON}",
        "args": [
          "-u",
          "{AGENTS_DIR}/meeting-planner/main.py",
          "--people",
          "{people}",
          "--urgency",
          "{urgency}",
          "--subject",
          "{subject}",
          "--duration_min",
          "{duration_min}"
        ],
        "cwd": "{AGENTS_DIR}/meeting-planner",
        "protocol": "jsonl"
      }
    }
  ]
}
